  "searchAnswer": {
    "description": "What the handler of `onSearch` returns, and what is sent as `surfaceSearchResult`. Invalid cases are normalized by the package; `sent` is what goes out (error: normalized).",
    "valid": [
      {
        "name": "two results",
        "value": {
          "requestId": "s-7",
          "options": [
            {
              "value": "c1",
              "label": "Müller AG",
              "subtitle": "Zürich",
              "image": "https://example.com/c1.png"
            },
            {
              "value": "c2",
              "label": "Meier GmbH",
              "image": "data:image/png;base64,iVBORw0KGgo="
            }
          ]
        }
      },
      {
        "name": "no results",
        "value": {
          "requestId": "s-8",
          "options": []
        }
      },
      {
        "name": "exactly 50 results",
        "value": {
          "requestId": "s-9",
          "options": {
            "@repeat": 50,
            "of": {
              "value": "v{k}",
              "label": "Option {k}"
            }
          }
        }
      }
    ],
    "invalid": [
      {
        "name": "51 results are cut to 50",
        "value": {
          "requestId": "s-10",
          "options": {
            "@repeat": 51,
            "of": {
              "value": "v{k}",
              "label": "Option {k}"
            }
          }
        },
        "error": "normalized",
        "sent": {
          "requestId": "s-10",
          "options": {
            "@repeat": 50,
            "of": {
              "value": "v{k}",
              "label": "Option {k}"
            }
          }
        }
      },
      {
        "name": "an image over http is left out",
        "value": {
          "requestId": "s-11",
          "options": [
            {
              "value": "c1",
              "label": "A",
              "image": "http://example.com/a.png"
            }
          ]
        },
        "error": "normalized",
        "sent": {
          "requestId": "s-11",
          "options": [
            {
              "value": "c1",
              "label": "A"
            }
          ]
        }
      },
      {
        "name": "an entry without a label is left out",
        "value": {
          "requestId": "s-12",
          "options": [
            {
              "value": "c1"
            },
            {
              "value": "c2",
              "label": "B"
            }
          ]
        },
        "error": "normalized",
        "sent": {
          "requestId": "s-12",
          "options": [
            {
              "value": "c2",
              "label": "B"
            }
          ]
        }
      }
    ]
