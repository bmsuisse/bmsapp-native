# Only for APNs (send_push) — copy to .env for the local example
# under example/, or set as real environment variables in your backend.
# See README.md for the steps in the Apple Developer Portal.

# Contents of the .p8 file on a single line, line breaks as \n. In production
# from Key Vault, see README.
APNS_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
APNS_KEY_ID=YOUR_KEY_ID
APNS_TEAM_ID=YOUR_TEAM_ID
APNS_BUNDLE_ID=YOUR_BUNDLE_ID
# true = development APNs server (Xcode debug builds), false = production.
APNS_USE_SANDBOX=true

# Sign-in with the Entra token of the app (docs/entra-token-guide.md). The
# example refuses to start without ENTRA_TENANT_ID; for local experiments only
# you can run it without any login via ALLOW_INSECURE_NO_AUTH=1 (never on a
# reachable host).
# Directory (tenant) ID and the client ID of the app registration of the iOS app
# (the `aud` of the token); several client IDs separated by commas.
ENTRA_TENANT_ID=YOUR_TENANT_ID
ENTRA_AUDIENCE=YOUR_IOS_APP_CLIENT_ID
# Signs the session cookie: random, at least 32 bytes, e.g. `openssl rand -hex 32`.
SESSION_SECRET=GENERATE_A_RANDOM_SECRET
